---
import { getCollection } from "astro:content";
import {byDateDesc, isRevised} from "../utils/notes.ts";

import Layout from "../components/Layout.astro";
import Heading from "../components/Heading.astro";
import Finis from "../components/Finis.astro";
import Prose from "../components/Prose.astro";

export const title = "Home ~ Ariel Messing";
const description = "A quiet place for composing and tinkering. Personal page of a Ariel Messing, software engineer & architect, based in the English countryside.";

const latestNote = (await getCollection("notes"))
  .sort(byDateDesc)[0];
const isLatestNoteRevised = isRevised(latestNote);
const latestNotePrimaryTag = latestNote.data.tags?.[0];
const isDaft = latestNotePrimaryTag === "observation";
---

<Layout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={
    JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": title,
      "description": description,
      "url": Astro.site?.href,
    }) 
  } />
    
  <section class="home">
    <header class="home-header">
      <p class="preamble">Hello, I'm</p>

      <Heading as="h1">Ariel</Heading>

      <p class="qualifier" aria-label="pronounced: ah-ree-ELLE">[ ah—ree—<em>elle</em> ]</p>

      <p class="tagline">
        Developer by trade, antiquarian by inclination; I appreciate thoughtful design, well-made code, and slow living.
      </p>
    </header>

    <Prose>
      <p>
        Welcome to my personal website: a craftsman's portfolio, of sort;
        an open <a href="/tags/">Zettelkasten</a>;
        a place to (uncommittedly) compose a fleeting observation
          — recently I {isLatestNoteRevised ? "revisited" : "shared"}
        <a href={"/notes/" + latestNote.id}>{isLatestNoteRevised ? "an old" : "a"} note</a>,
        {isDaft && "daftly"} tagged <span class="tag-name">{latestNotePrimaryTag}</span> —
        or tinker with the occasional quiet web idea.
      </p>
    </Prose>

    <Finis />
  </section>
</Layout>

<style>
  .home {
    max-width: var(--width-content);
  }

  .home-header {
    margin-bottom: var(--space-xl);
  }

  .preamble {
    font-family: var(--font-heading);
    color: var(--color-text-tertiary);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: var(--space-md);
  }

  .qualifier {
    font-family: var(--font-body);
    color: var(--color-text-tertiary);
  }

  .tagline {
    margin-top: var(--space-lg);
    font-family: var(--font-body);
    color: var(--color-text-secondary);
    font-size: 1.125rem;
  }

  :global(p) {
    color: var(--color-text-tertiary);
  }

  :global(.tag-name)::before {
    content: "#";
    opacity: var(--text-opacity);
  }
</style>
