---
import { getCollection } from "astro:content";
import { byDateDesc, hasTag } from "../../utils/notes";

import Layout from "../../components/Layout.astro";
import Heading from "../../components/Heading.astro";
import NoteList from "../../components/NoteList.astro";
import Finis from "../../components/Finis.astro";

import { title as indexTitle } from "../index.astro";

export async function getStaticPaths() {
  const allNotes = await getCollection("notes");

  const uniqueTags = [...new Set(allNotes.flatMap(note => note.data.tags))];

  return uniqueTags.map(tag => {
    const filteredNotes = allNotes
      .filter(hasTag(tag))
      .sort(byDateDesc);

    return {
      params: { tag },
      props: { notes: filteredNotes },
    }
  });
}

const { tag } = Astro.params;
const { notes } = Astro.props;

const title = `Tag: ${tag} ~ Ariel Messing`;
const description = `Notes about ${tag}, by Ariel Messing`

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": title,
  "numberOfItems": notes.length,
  "itemListElement": notes.map((note, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "BlogPosting",
      "headline": note.data.title,
      "url": new URL(`/notes/${note.id}`, Astro.site).href,
      "datePublished": note.data.date.toISOString(),
      "description": note.data.description
    }
  })),
  "isPartOf": {
    "@type": "WebSite",
    "name": indexTitle,
    "url": Astro.site?.href,
  }
};
---

<Layout title={title}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd) } />
  
  <section class="tag">
    <header class="tag-header">
      <div class="tag-title">
        <Heading as="h1"><span class="tag-name">{tag}</span></Heading>
      </div>
      <nav>
        <a href="/tags/">see all tags</a>
      </nav>
    </header>

    <NoteList items={notes} />

    <footer>
      <Finis />
    </footer>
  </section>
</Layout>

<style>
  .tag-title {
    margin-bottom: var(--space-2xl);
  }

  .tag-header .tag-name::before {
    content: "#";
    opacity: 0.45;
  }

  nav a {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    color: var(--color-text-tertiary);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  nav a:hover {
    color: var(--color-accent);
  }
</style>